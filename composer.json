{
    "name": "vaslv/composer-release",
    "description": "Interactive release helper: picks the next semver version from existing git tags, then creates an annotated tag and optionally pushes it. Tag-only — no release commit, nothing in the working tree changes. Available as `composer release`.",
    "type": "composer-plugin",
    "license": "MIT",
    "keywords": ["release", "semver", "git", "tag", "version", "composer-plugin"],
    "authors": [
        {
            "name": "Andrei Vasilev"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Vaslv\\Release\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vaslv\\Release\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/release"
    ],
    "extra": {
        "class": "Vaslv\\Release\\Plugin"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "config": {
        "sort-packages": true
    }
}
