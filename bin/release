#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [[ -n "$(git status --porcelain)" ]]; then
    echo "error: working tree is dirty — commit or stash first" >&2
    exit 1
fi

branch="$(git rev-parse --abbrev-ref HEAD)"
if [[ "$branch" == "HEAD" ]]; then
    echo "error: detached HEAD — check out a branch first" >&2
    exit 1
fi
if [[ "$branch" != "main" && "$branch" != "master" ]]; then
    read -rp "Current branch is '$branch' (not main). Continue? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || exit 1
fi

has_origin=0
if git remote get-url origin >/dev/null 2>&1; then
    has_origin=1
    git fetch --tags --quiet origin \
        || echo "warning: could not fetch tags from origin — using local tags only" >&2
fi

# semver.org: numeric components must not have leading zeros
semver_re='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'

# Strip the optional v before comparing: git's version sort ranks every
# v-prefixed tag above every bare one, so mixed-style repos would pick a
# wrong (lower) "latest" version.
current="$(git tag --list | grep -E "^v?${semver_re}\$" | sed 's/^v//' \
    | sort -t. -k1,1n -k2,2n -k3,3n | tail -n1 || true)"

if [[ -z "$current" ]]; then
    current="0.0.0"
    prefix=""
    echo "No existing version tags found. Starting from 0.0.0." >&2
else
    # both styles may tag the same version; prefer the v-prefixed one
    if git rev-parse -q --verify "refs/tags/v$current" >/dev/null; then
        prefix="v"
    else
        prefix=""
    fi
    echo "Current version: ${prefix}${current}" >&2
fi

IFS='.' read -r major minor patch <<<"$current"

next_patch="$major.$minor.$((patch + 1))"
next_minor="$major.$((minor + 1)).0"
next_major="$((major + 1)).0.0"

cat >&2 <<EOF

Select next version:
  1) patch  → ${prefix}${next_patch}
  2) minor  → ${prefix}${next_minor}
  3) major  → ${prefix}${next_major}
  4) custom
  q) quit

EOF

read -rp "Choice [1-4/q]: " choice

case "$choice" in
    1) new="$next_patch" ;;
    2) new="$next_minor" ;;
    3) new="$next_major" ;;
    4)
        read -rp "Enter version (without prefix, e.g. 1.2.3): " new
        [[ "$new" =~ ^${semver_re}$ ]] || { echo "Invalid semver" >&2; exit 1; }
        ;;
    q|Q) exit 0 ;;
    *) echo "Invalid choice" >&2; exit 1 ;;
esac

tag="${prefix}${new}"

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
    echo "error: tag $tag already exists" >&2
    exit 1
fi

echo >&2
echo "About to release: $tag" >&2
read -rp "Proceed? [y/N] " ans
[[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted" >&2; exit 0; }

# The tag is the only source of truth, so a release writes nothing: no version
# field to bump, no release commit, no rollback path to get wrong. A project
# that still commits a `version` field in composer.json is warned, because the
# field is no longer touched here and will drift from the tag it claims to
# mirror. (Top-level field assumed — good enough for a grep; nested "version"
# keys in exotic configs are not our audience.)
if [[ -f composer.json ]] && grep -Eq '"version"[[:space:]]*:' composer.json; then
    cat >&2 <<'EOF'
warning: composer.json still commits a "version" field. This command no longer
         updates it, so it will drift from the tag. Remove the field and run
         `composer update --lock` to refresh the lock file's content hash.
EOF
fi

# The message defaults to the tag itself; a project that wants its own wording
# sets a template once and forgets about it:
#
#     git config release.tagMessage 'Release {tag}'
#
# {tag} is replaced with the tag being created (prefix included); a template
# without the placeholder is used verbatim. The substitution is plain parameter
# expansion — never eval — so `$(...)`, backticks and the like survive into the
# message as literal text instead of running.
template="$(git config --get release.tagMessage || true)"
if [[ -n "$template" ]]; then
    message="${template//\{tag\}/$tag}"
else
    message="$tag"
fi

git tag -a "$tag" -m "$message"

echo >&2
echo "Created tag $tag locally. Nothing in the working tree changed." >&2

if [[ "$has_origin" -eq 1 ]]; then
    read -rp "Push to origin now? [y/N] " ans || ans="n"
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        # The branch still goes with the tag even though the release creates no
        # commit: the tagged commit may simply not be on origin yet, and an
        # atomic push either lands both or neither, never a tag pointing at a
        # commit nobody else can fetch.
        git push --atomic origin "$branch" "$tag"
        echo "Pushed." >&2
    else
        echo "Not pushed. Run: git push --atomic origin $branch $tag" >&2
    fi
else
    echo "No 'origin' remote configured — tag created locally, nothing to push." >&2
fi
